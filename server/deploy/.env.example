# Copy to server/deploy/.env and edit. Never commit the real .env (it is git-ignored).
# The required settings below have an empty value (or a placeholder to replace): `docker compose
# up` refuses to start while a required one is empty. Values may be unquoted; a "#" starts a
# comment only after a space.

# --- Required ----------------------------------------------------------------------------------

# Public hostname of the scoreboard. Its DNS A (and AAAA) record must point at this VM before
# the first start, and ports 80 and 443 must be reachable, or Caddy cannot get a certificate.
DOMAIN=scoreboard.example.org

# Shared secret for /api/v1/admin/* (header X-Admin-Secret). It can reset progress and force the
# finale open. Generate one:  openssl rand -hex 24
ADMIN_SECRET=

# Origins allowed to call the API from a browser, comma-separated, no trailing slash. The game
# served by this stack (https://$DOMAIN) is same-origin and needs NO CORS entry. This setting is
# only for the GitHub Pages staging mirror, https://johnsonfarmsus.github.io (an origin is scheme
# + host, never a path), and any other site that should call the API. Do not use * in production.
CORS_ORIGINS=https://johnsonfarmsus.github.io

# The gnu's note codes hidden around the venue, comma-separated. Their count is N. Matching
# ignores case and punctuation. Must match what is printed on the notes.
GNU_NOTE_CODES=

# The line's start code (matched ignoring punctuation). The built-in value in the repository is
# public, so set it deliberately, to the digits as printed on the cookie packs.
START_CODE=

# --- Optional ----------------------------------------------------------------------------------

# Host directory holding the game's web build (releases/ and the `current` symlink). Caddy mounts
# it read-only at /srv/fortune. The CI deploy writes here over SSH; see docs/DEPLOY.md.
GAME_DIR=/srv/fortune

# How many notes the finale needs (k). Capped at N; with no codes nothing is needed.
GNU_NOTES_K=3

# After this moment the finale opens regardless of progress. ISO 8601, and the UTC OFFSET IS
# REQUIRED: the server rejects a time without one and will not start. Write the venue's local
# wall-clock time with that zone's offset on that date. Portland in late October is PDT (-07:00),
# so 5pm local is 2027-10-29T17:00:00-07:00, the same moment as 2027-10-30T00:00:00Z. After the
# clocks go back in early November the offset would be -08:00. Leave empty for no safety net. It
# can be changed at runtime without a restart (docs/DEPLOY.md, PUT /api/v1/admin/finale/safety-net).
FINALE_SAFETY_NET_AT=

# Source link in the big-screen footer. The AGPL requires offering the source of the code you
# actually run to the people using it: point this at your repository (or your fork).
REPO_URL=https://github.com/johnsonfarmsus/fortune-teahouse-puzzle

# Caddy sits in front and appends the real client address, so the app should trust the rightmost
# X-Forwarded-For entry for rate limiting. Keep true with this compose file. The app container
# publishes no port, so clients cannot bypass Caddy.
TRUST_PROXY=true

# Tag for the locally built image. Set a new tag (for example the git short SHA) before a
# deploy to keep the previous image around for a quick rollback.
SCOREBOARD_IMAGE_TAG=latest

# --- Used by backup.sh and healthcheck.sh (they also read these from this file) -------------------

# Where backup.sh writes dated copies, and how many daily copies to keep.
BACKUP_DIR=/var/backups/fortune-scoreboard
BACKUP_KEEP=14

# Optional off-VM copy: an rsync destination such as user@backuphost:/srv/backups/fortune/
# Leave empty to keep backups on this VM only (they then die with the VM; see docs/DEPLOY.md).
BACKUP_RSYNC_TARGET=

# Optional dead-man switch: healthcheck.sh requests this URL after every successful check
# (for example a healthchecks.io ping URL), so you hear about it when checks stop arriving.
HEALTHCHECK_PING_URL=
